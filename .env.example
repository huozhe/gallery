# Redis (Vercel marketplace) — leave unset to use file-based local dev store
REDIS_URL=

# Key prefix for Redis — set to "dev:" locally to isolate from production keys
# Leave unset (or set to "prod:") in the Vercel production environment
REDIS_KEY_PREFIX=

# Vercel Blob — leave unset to write uploads to public/ on disk
BLOB_READ_WRITE_TOKEN=

# Admin user — auto-seeded into Redis on first request if no users exist
GALLERY_ADMIN_EMAIL=
GALLERY_ADMIN_PASSWORD=
