# Vercel KV — leave unset to use file-based local dev store
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob — leave unset to write uploads to public/ on disk
BLOB_READ_WRITE_TOKEN=

# Admin user — auto-seeded into KV on first request if no users exist
GALLERY_ADMIN_EMAIL=
GALLERY_ADMIN_PASSWORD=
