# Redis (Vercel marketplace) — leave unset to use file-based local dev store
REDIS_URL=

# Key prefix for Redis — set to "dev:" locally to isolate from production keys
# Leave unset (or set to "prod:") in the Vercel production environment
REDIS_KEY_PREFIX=

# Vercel Blob — leave unset to write uploads to public/ on disk
BLOB_READ_WRITE_TOKEN=

# Path prefix for Blob uploads — set to "dev/" locally to isolate from production assets
# Leave unset in the Vercel production environment
BLOB_PATH_PREFIX=

# Admin user — auto-seeded into Redis on first request if no users exist
GALLERY_ADMIN_EMAIL=
GALLERY_ADMIN_PASSWORD=

# Vercel sets this automatically for cron jobs; the /api/admin/backup endpoint accepts it as a Bearer token.
# Set locally only if you want to test the cron auth path in dev.
# CRON_SECRET=
